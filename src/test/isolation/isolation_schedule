# ----------
# src/test/isolation/isolation_schedule
#
# See src/test/regress/parallel_schedule for the syntax; a "run:" line
# without directives is kept apart only from lines that say so.  Specs that
# create and drop objects of the same name are marked "notwith:" each other,
# and what a spec needs of the database beyond its own objects is named as a
# resource: the statistics it resets ("stats"), the notify queue whose
# cluster-wide counters it measures ("notify"), the serializable
# transactions its outcome is decided against ("serializable"), a temporary
# schema of another session it inspects ("temp_schema"), and the advisory
# lock keys it takes ("advisory_<key>", or "advisory_locks" for a spec whose
# keys are not constants).
#
# Two kinds of spec cannot share the database.  Those that need VACUUM to
# see no other snapshot, or run a database-wide VACUUM, run with nothing
# else at all.  Those that wait out every transaction running when their
# step starts -- CREATE INDEX, REINDEX and DETACH PARTITION CONCURRENTLY --
# run as one group: among other specs they wait for whatever those hold,
# which costs several times their own runtime, but they hold nothing for
# long themselves and so hardly disturb each other.  Sharing a line is not
# an exclusion between the specs on it, so one that also falls under the
# first rule stays out of the group: detach-partition-concurrently-4
# freezes pg_inherits and runs alone.
#
# Every spec opens one connection per session plus one, and
# pg_isolation_regress keeps the total within --max-connections (40 by
# default, less if the server allows fewer), so about ten specs run at once.
# ----------

#   notwith *: detach-partition-concurrently-1: it waits for every transaction of this database to finish, runs with its group
run: multiple-cic detach-partition-concurrently-1 detach-partition-concurrently-2 detach-partition-concurrently-3 reindex-concurrently reindex-concurrently-toast reindex-schema drop-index-concurrently-1 notwith: *
#   notwith *: plpgsql-toast: VACUUM must see no other snapshot in this database, runs alone
run: plpgsql-toast notwith: *
#   notwith *: intra-grant-inplace-db: database-wide VACUUM or ANALYZE
run: intra-grant-inplace-db notwith: *
#   notwith *: detach-partition-concurrently-4: VACUUM must see no other snapshot in this database, runs alone
run: detach-partition-concurrently-4 notwith: *
#   notwith *: index-only-scan: VACUUM must see no other snapshot in this database, runs alone
run: index-only-scan notwith: *
#   notwith *: vacuum-no-cleanup-lock: VACUUM must see no other snapshot in this database, runs alone
run: vacuum-no-cleanup-lock notwith: *
#   notwith *: freeze-the-dead: VACUUM must see no other snapshot in this database, runs alone
run: freeze-the-dead notwith: *
#   notwith *: index-only-bitmapscan: VACUUM must see no other snapshot in this database, runs alone
run: index-only-bitmapscan notwith: *
